@startuml classes-dominio
!include ../_estilo.iuml

title Modelo de domínio

hide empty members

class Money <<value>> {
  amount: BigInteger
  asset: Asset
}

enum Asset {
  BRL
  ETH
}

class Merchant {
  id: UUID
  subjectId: String
  displayName: String
  ownerId: UUID
}

class Payment {
  id: UUID
  sourceRail: Rail
  destinationRail: Rail
  amount: Money
  status: PaymentStatus
  expiresAt: Instant
}

package "pix" {
  class PixCharge <<imutável>> {
    txid: String
    brCode: String
  }

  class PixTransfer <<imutável>> {
    kind: PixTransferKind
    endToEndId: String
    occurredAt: Instant
  }

  class Med <<imutável>> {
    infractionId: String
    openedAt: Instant
  }

  class MedEvent <<imutável>> {
    status: MedStatus
    occurredAt: Instant
  }

  class PixPayout <<imutável>> {
    keyId: UUID
  }
}

package "ethereum" {
  class EthereumCharge <<imutável>> {
    onchainId: Bytes32
    amount: Money
  }

  class EthereumPayout <<imutável>> {
    walletId: UUID
  }

  class EthereumHold <<imutável>> {
    releaseAt: Instant
  }

  class EthereumTransaction <<imutável>> {
    kind: EthereumTransactionKind
    txHash: Bytes32
    logIndex: int
    occurredAt: Instant
  }
}

enum Rail {
  PIX
  ETHEREUM
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PAID
  CONVERTING
  HELD
  DELIVERING
  COMPLETED
  EXPIRED
  REFUNDING
  REFUNDED
  REVERSED
  FAILED
}

enum MedStatus {
  OPEN
  RECOVERED
  NOT_RECOVERABLE
  CLOSED
}

class JournalEntry <<imutável>> {
  kind: EntryKind
  occurredAt: Instant
}

class Posting <<imutável>> {
  account: LedgerAccount
  amount: Money
}

enum LedgerAccount {
  PAYER
  MERCHANT
  GATEWAY
  ESCROW
  CONVERSION_PROVIDER
  RECOVERY
}

enum EntryKind {
  PAYMENT_RECEIVED
  CONVERSION
  HOLD
  RELEASE
  PAYOUT
  REFUND
  REVERSAL
}

class Job {
  type: String
  dedupKey: String
  status: JobStatus
  attempts: int
  runAt: Instant
}

class IdentityStoreNode {
  id: UUID
  baseUrl: String
  status: NodeStatus
  certificateNotAfter: Instant
}

Money --> Asset
Merchant --> "1" IdentityStoreNode : dados pessoais em
Merchant "1" -- "0..*" Payment
Payment --> Rail
Payment --> PaymentStatus
JournalEntry *-- "0..1" PixTransfer : prova no Pix
Payment *-- "0..*" Med
Med *-- "1..*" MedEvent
MedEvent --> MedStatus
JournalEntry *-- "0..1" EthereumTransaction : prova na rede
Payment *-- "0..1" PixCharge : pagador em Pix
Payment *-- "0..1" EthereumCharge : pagador em Ethereum
Payment *-- "0..1" EthereumPayout : lojista recebe em Ethereum
Payment *-- "0..1" EthereumHold : retenção no contrato
Payment *-- "0..1" PixPayout : lojista recebe em Pix
Payment *-- "0..*" JournalEntry
JournalEntry *-- "2..*" Posting
Posting --> LedgerAccount
Payment "0..1" -- "0..*" Job
JournalEntry --> EntryKind

note right of JournalEntry
  Livro-razão por partidas dobradas: cada movimento
  de dinheiro é um lançamento com partidas que somam
  zero por ativo. Tipos e contas não dependem do
  trilho; o registro do trilho (PixTransfer,
  EthereumTransaction) guarda o identificador externo.
end note
@enduml
