@startuml classes-dominio
!pragma layout elk
!include ../_estilo.iuml

title Modelo de domínio

hide empty members
skinparam linetype ortho
skinparam wrapWidth 420

package "Participantes" {
  class Merchant {
    id: UUID
    subjectId: String
    displayName: String
    ownerId: UUID
    createdAt: Instant
  }

  class IdentityStoreNode {
    id: UUID
    baseUrl: String
    status: IdentityStoreStatus
    certificateSerial: String
    certificateNotAfter: Instant
    revoke()
    renewCertificate(serial: String, notAfter: Instant)
  }

  enum IdentityStoreStatus {
    ACTIVE
    REVOKED
  }
}

package "Processamento" {
  class Job {
    id: UUID
    type: JobType
    status: JobStatus
    attempts: int
    runAt: Instant
    lastError: String [0..1]
    complete()
    fail(error: String, nextRunAt: Instant)
    retry()
  }

  enum JobType {
    CONFIRM_PAYMENT
    FUND_CONVERSION
    CONVERT
    PAY_OUT
    RELEASE
    RECOVER
    REFUND
  }

  enum JobStatus {
    PENDING
    DONE
    FAILED
  }
}

package "Pagamento" {
  class Payment <<imutável>> {
    id: UUID
    /sourceRail: Rail
    /destinationRail: Rail
    amount: Money
    expiresAt: Instant
    createdAt: Instant
    /status: PaymentStatus
    «create» Payment(id: UUID, merchant: Merchant, amount: Money, expiresAt: Instant, charge: Charge, payout: Payout)
    placeHold(hold: Hold)
  }

  enum PaymentStatus {
    AWAITING_PAYMENT
    PROCESSING
    COMPLETED
    EXPIRED
    REFUNDED
    REVERSED
    FAILED
  }

  enum Rail {
    PIX
    ETHEREUM
  }

  abstract class Charge <<imutável>>
  class PixCharge <<imutável>> {
    txid: String
    brCode: String
  }
  class EthereumCharge <<imutável>> {
    onchainId: Bytes32
    amount: Money
  }

  abstract class Payout <<imutável>>
  class PixPayout <<imutável>> {
    keyId: UUID
  }
  class EthereumPayout <<imutável>> {
    walletId: UUID
  }

  abstract class Hold <<imutável>>
  class EthereumHold <<imutável>> {
    releaseAt: Instant
  }
}

package "Livro-razão" {
  class JournalEntry <<imutável>> {
    id: UUID
    occurredAt: Instant
    «create» JournalEntry(payment: Payment, occurredAt: Instant, detail: EntryDetail, postings: Posting[2..*])
  }

  class Posting <<imutável>> {
    account: LedgerAccount
    amount: Money
  }

  enum LedgerAccount {
    PAYER
    MERCHANT
    GATEWAY
    ESCROW
    CONVERSION_PROVIDER
    RECOVERY
  }

  abstract class EntryDetail <<imutável>>

  class PixTransfer <<imutável>> {
    kind: PixTransferKind
    endToEndId: String
  }

  class EthereumTransaction <<imutável>> {
    kind: EthereumTransactionKind
    txHash: Bytes32
    logIndex: int
  }

  class Conversion <<imutável>> {
    provider: ConversionProviderType
    providerOrderId: String
  }

  enum PixTransferKind {
    RECEIVED
    PAID_OUT
    CONVERSION_FUNDED
    RETURNED
    MED_RETURNED
  }

  enum EthereumTransactionKind {
    PAID
    HELD
    RELEASED
    CONVERSION_FUNDED
    REFUNDED
    RECOVERED
  }

  enum ConversionProviderType {
    MOCK
  }
}

package "MED" {
  class Med <<imutável>> {
    id: UUID
    infractionId: String
    openedAt: Instant
    «create» Med(payment: Payment, infractionId: String, openedAt: Instant)
    record(status: MedStatus, occurredAt: Instant): MedEvent
  }

  class MedEvent <<imutável>> {
    seq: int
    status: MedStatus
    occurredAt: Instant
  }

  enum MedStatus {
    OPEN
    RECOVERED
    NOT_RECOVERABLE
    CLOSED
  }
}

package "Tipos comuns" {
  class Money <<value>> {
    amount: BigInteger
    asset: Asset
  }

  enum Asset {
    BRL
    ETH
  }
}

' Associações
IdentityStoreNode "1" -- "0..*" Merchant : dados pessoais em
Merchant "1" -- "0..*" Payment
Job "0..*" -- "1" Payment : {um por tipo}
Payment "1" -- "0..*" JournalEntry
Payment "1" -- "0..*" Med

' Composições
Payment *-- "1" Charge
Payment *-- "1" Payout
Payment *-- "0..1" Hold
JournalEntry *-- "2..*" Posting
JournalEntry *-- "1" EntryDetail
Med *-- "1..*" MedEvent

' Generalizações
Charge <|-- PixCharge
Charge <|-- EthereumCharge
Payout <|-- PixPayout
Payout <|-- EthereumPayout
Hold <|-- EthereumHold
EntryDetail <|-- PixTransfer
EntryDetail <|-- EthereumTransaction
EntryDetail <|-- Conversion


' Dependências de tipo
IdentityStoreNode ..> IdentityStoreStatus
Job ..> JobType
Job ..> JobStatus
Payment ..> PaymentStatus
Payment ..> Rail
Posting ..> LedgerAccount
PixTransfer ..> PixTransferKind
EthereumTransaction ..> EthereumTransactionKind
Conversion ..> ConversionProviderType
MedEvent ..> MedStatus
Money ..> Asset

' Posicionamento (sem significado no modelo)
Merchant -[hidden]- Money
Job -[hidden]- Money
Hold -[hidden]- JournalEntry
@enduml
