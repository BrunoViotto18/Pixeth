@startuml classes-dominio
!include ../_estilo.iuml

title Modelo de domínio

hide empty members

class Money <<value>> {
  amount: BigInteger
  asset: Asset
}

enum Asset {
  BRL
  ETH
}

class Merchant {
  id: UUID
  subjectId: String
  displayName: String
  ownerId: UUID
}

class Payment {
  id: UUID
  sourceRail: Rail
  destinationRail: Rail
  amount: Money
  status: PaymentStatus
  expiresAt: Instant
}

package "pix" {
  class PixCharge {
    txid: String
    brCode: String
    expiresAt: Instant
    medStatus: MedStatus
  }

  class PixPayout {
    keyId: UUID
  }
}

package "ethereum" {
  class EthereumCharge {
    onchainId: Bytes32
    amount: Money
    quoteExpiresAt: Instant
  }

  class EthereumPayout {
    walletId: UUID
  }

  class EthereumHold {
    releaseAt: Instant
  }
}

enum Rail {
  PIX
  ETHEREUM
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PAID
  CONVERTING
  HELD
  DELIVERING
  COMPLETED
  EXPIRED
  REFUNDING
  REFUNDED
  REVERSED
  FAILED
}

enum MedStatus {
  OPEN
  RECOVERED
  NOT_RECOVERABLE
  CLOSED
}

class JournalEntry <<imutável>> {
  kind: EntryKind
  externalId: String
  occurredAt: Instant
}

class Posting <<imutável>> {
  account: LedgerAccount
  amount: Money
}

enum LedgerAccount {
  PAYER
  MERCHANT
  PIX_ACCOUNT
  CONTRACT_ESCROW
  CONVERSION_PROVIDER
  RECOVERY
}

enum EntryKind {
  PIX_IN
  PIX_OUT
  PIX_REFUND
  CHAIN_PAID
  CHAIN_HELD
  CHAIN_RELEASED
  CHAIN_FORWARDED
  CHAIN_REFUNDED
  CHAIN_RECOVERED
  CONVERSION
}

class Job {
  type: String
  dedupKey: String
  status: JobStatus
  attempts: int
  runAt: Instant
}

class IdentityStoreNode {
  id: UUID
  baseUrl: String
  status: NodeStatus
  certificateNotAfter: Instant
}

Money --> Asset
Merchant --> "1" IdentityStoreNode : dados pessoais em
Merchant "1" -- "0..*" Payment
Payment --> Rail
Payment --> PaymentStatus
PixCharge --> MedStatus
Payment *-- "0..1" PixCharge : pagador em Pix
Payment *-- "0..1" EthereumCharge : pagador em Ethereum
Payment *-- "0..1" EthereumPayout : lojista recebe em Ethereum
Payment *-- "0..1" EthereumHold : retenção no contrato
Payment *-- "0..1" PixPayout : lojista recebe em Pix
Payment *-- "0..*" JournalEntry
JournalEntry *-- "2..*" Posting
Posting --> LedgerAccount
Payment "0..1" -- "0..*" Job
JournalEntry --> EntryKind

note right of JournalEntry
  Livro-razão por partidas dobradas: cada movimento
  de dinheiro é um lançamento com partidas que somam
  zero por ativo; external_id guarda o endToEndId ou
  o txHash do movimento.
end note
@enduml
