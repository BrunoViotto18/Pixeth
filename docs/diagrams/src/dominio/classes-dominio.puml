@startuml classes-dominio
!pragma layout elk
!include ../_estilo.iuml

title Modelo de domínio

hide empty members
skinparam linetype ortho

package "Participantes" {
  class Merchant {
    id: UUID
    subjectId: String
    displayName: String
    ownerId: UUID
  }

  class IdentityStoreNode {
    id: UUID
    baseUrl: String
    status: NodeStatus
    certificateNotAfter: Instant
  }
}

package "Processamento" {
  class Job {
    type: JobType
    dedupKey: String
    status: JobStatus
    attempts: int
    runAt: Instant
  }

  enum JobType {
    CONFIRM_PAYMENT
    FORWARD
    CONVERT
    PAY_OUT
    RELEASE
    RECOVER
    REFUND
  }

  enum JobStatus {
    PENDING
    DONE
    FAILED
  }
}

package "Pagamento" {
  class Payment <<imutável>> {
    id: UUID
    sourceRail: Rail
    destinationRail: Rail
    amount: Money
    expiresAt: Instant
    /status: PaymentStatus
  }

  enum PaymentStatus {
    AWAITING_PAYMENT
    PROCESSING
    COMPLETED
    EXPIRED
    REFUNDED
    REVERSED
    FAILED
  }

  class PixCharge <<imutável>> {
    txid: String
    brCode: String
  }

  class PixPayout <<imutável>> {
    keyId: UUID
  }

  class EthereumCharge <<imutável>> {
    onchainId: Bytes32
    amount: Money
  }

  class EthereumPayout <<imutável>> {
    walletId: UUID
  }

  class EthereumHold <<imutável>> {
    releaseAt: Instant
  }
}

package "Livro-razão" {
  class JournalEntry <<imutável>> {
    source: EntrySource
    occurredAt: Instant
  }

  class Posting <<imutável>> {
    account: LedgerAccount
    amount: Money
  }

  class PixTransfer <<imutável>> {
    kind: PixTransferKind
    endToEndId: String
    occurredAt: Instant
  }

  class EthereumTransaction <<imutável>> {
    kind: EthereumTransactionKind
    txHash: Bytes32
    logIndex: int
    occurredAt: Instant
  }

  class Conversion <<imutável>> {
    provider: ConversionProvider
    providerOrderId: String
    occurredAt: Instant
  }

  enum EntrySource {
    PIX
    ETHEREUM
    CONVERSION
  }

  enum LedgerAccount {
    PAYER
    MERCHANT
    GATEWAY
    ESCROW
    CONVERSION_PROVIDER
    RECOVERY
  }

  enum PixTransferKind {
    RECEIVED
    SENT
    FORWARDED
    RETURNED
    MED_RETURNED
  }

  enum EthereumTransactionKind {
    PAID
    HELD
    RELEASED
    FORWARDED
    REFUNDED
    RECOVERED
  }
}

package "MED" {
  class Med <<imutável>> {
    infractionId: String
    openedAt: Instant
  }

  class MedEvent <<imutável>> {
    seq: int
    status: MedStatus
    occurredAt: Instant
  }

  enum MedStatus {
    OPEN
    RECOVERED
    NOT_RECOVERABLE
    CLOSED
  }
}

package "Tipos comuns" {
  class Money <<value>> {
    amount: BigInteger
    asset: Asset
  }

  enum Asset {
    BRL
    ETH
  }

  enum Rail {
    PIX
    ETHEREUM
  }
}

' Associações
IdentityStoreNode "1" -down- "0..*" Merchant : dados pessoais em
Merchant "1" -down- "0..*" Payment
Job "0..*" -down- "0..1" Payment
Payment *-down- "0..1" PixCharge
Payment *-down- "0..1" PixPayout
Payment *-down- "0..1" EthereumCharge
Payment *-down- "0..1" EthereumPayout
Payment *-down- "0..1" EthereumHold
Payment *-down- "0..*" JournalEntry
Payment *-down- "0..*" Med
JournalEntry *-down- "2..*" Posting
JournalEntry *-down- "0..1" PixTransfer
JournalEntry *-down- "0..1" EthereumTransaction
JournalEntry *-down- "0..1" Conversion
Med *-down- "1..*" MedEvent

' Posicionamento (sem significado no modelo)
JobType -[hidden]down- Job
JobStatus -[hidden]down- Job
Payment -[hidden]right- PaymentStatus
JournalEntry -[hidden]down- EntrySource
Posting -[hidden]down- LedgerAccount
PixTransfer -[hidden]down- PixTransferKind
EthereumTransaction -[hidden]down- EthereumTransactionKind
MedEvent -[hidden]down- MedStatus
Money -[hidden]down- Asset
Asset -[hidden]right- Rail
@enduml
