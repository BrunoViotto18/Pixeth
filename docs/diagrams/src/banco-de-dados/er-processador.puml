@startuml er-processador
!include ../_estilo.iuml

title Banco do processador

hide circle
hide empty members
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 70
skinparam noteTextAlignment left

package "Participantes" as g_part {
  entity "core.identity_stores" as identity_stores {
    * id : uuid <<PK>>
    --
    * base_url : text
    * status : core.identity_store_status
    * certificate_serial : text
    * certificate_not_after : timestamptz
  }

  entity "core.merchants" as merchants {
    * id : uuid <<PK>>
    --
    * subject_id : text <<UK>>
    * display_name : text
    * identity_store_id : uuid <<FK>>
    * owner_id : uuid
    * created_at : timestamptz
  }

  enum "core.identity_store_status" as e_isstatus {
    ACTIVE
    REVOKED
  }

  note right of merchants
    Sem dados pessoais.
    owner_id, key_id e wallet_id
    (IdentityStore) e subject_id
    (Keycloak) são referências
    lógicas, sem chave estrangeira.
  end note
}

package "Processamento" as g_proc {
  entity "core.jobs" as jobs {
    * id : uuid <<PK>>
    --
    * type : core.job_type
    payment_id : uuid <<FK>>
    * dedup_key : text <<UK>>
    * payload : jsonb
    * status : core.job_status
    * attempts : int
    * run_at : timestamptz
    last_error : text
  }

  entity "core.idempotency_keys" as idem {
    * scope_id : uuid <<PK>>
    * key : text <<PK>>
    --
    * request_hash : text
    * resource_id : uuid
    * expires_at : timestamptz
  }

  entity "ethereum.chain_cursor" as chain_cursor {
    * chain_id : bigint <<PK>>
    --
    * last_block : bigint
  }

  enum "core.job_type" as e_jtype {
    CONFIRM_PIX
    CONFIRM_DEPOSIT
    CONVERT
    PAY_OUT_PIX
    RELEASE
    RECOVER
    REFUND
    EXPIRE
  }

  enum "core.job_status" as e_jstatus {
    PENDING
    DONE
    FAILED
  }
}

package "MED" as g_med {
  entity "pix.meds" as pix_meds <<imutável>> #EAF3EA {
    * id : uuid <<PK>>
    --
    * payment_id : uuid <<FK>>
    * infraction_id : text <<UK>>
    * opened_at : timestamptz
  }

  entity "pix.med_events" as pix_med_events <<imutável>> #EAF3EA {
    * id : uuid <<PK>>
    --
    * med_id : uuid <<FK>>
    * status : pix.med_status
    * occurred_at : timestamptz
  }

  enum "pix.med_status" as e_med {
    OPEN
    RECOVERED
    NOT_RECOVERABLE
    CLOSED
  }
}

package "Pagamento" as g_pay {
  entity "core.payments" as payments {
    * id : uuid <<PK>>
    --
    * merchant_id : uuid <<FK>>
    * source_rail : core.rail
    * destination_rail : core.rail
    * amount : numeric(78,0)
    * asset : core.asset
    * status : core.payment_status
    * expires_at : timestamptz
    * version : bigint
    * created_at : timestamptz
  }

  enum "core.payment_status" as e_pstatus {
    AWAITING_PAYMENT
    PAID
    CONVERTING
    HELD
    DELIVERING
    COMPLETED
    EXPIRED
    REFUNDING
    REFUNDED
    REVERSED
    FAILED
  }

  entity "pix.payouts" as pix_payouts <<imutável>> #EAF3EA {
    * payment_id : uuid <<PK, FK>>
    --
    * key_id : uuid
  }

  entity "ethereum.charges" as eth_charges <<imutável>> #EAF3EA {
    * payment_id : uuid <<PK, FK>>
    --
    * onchain_id : bytea <<UK>>
    * amount_wei : numeric(78,0)
  }

  entity "pix.charges" as pix_charges <<imutável>> #EAF3EA {
    * payment_id : uuid <<PK, FK>>
    --
    * txid : text <<UK>>
    * br_code : text
  }

  entity "ethereum.payouts" as eth_payouts <<imutável>> #EAF3EA {
    * payment_id : uuid <<PK, FK>>
    --
    * wallet_id : uuid
  }

  entity "ethereum.holds" as eth_holds <<imutável>> #EAF3EA {
    * payment_id : uuid <<PK, FK>>
    --
    * release_at : timestamptz
  }
}

package "Livro-razão" as g_ledger {
  entity "core.journal_entries" as entries <<imutável>> #EAF3EA {
    * id : uuid <<PK>>
    --
    * payment_id : uuid <<FK>>
    * kind : core.entry_kind
    * occurred_at : timestamptz
  }

  entity "core.postings" as postings <<imutável>> #EAF3EA {
    * id : uuid <<PK>>
    --
    * entry_id : uuid <<FK>>
    * account : core.ledger_account
    * asset : core.asset
    * amount : numeric(78,0)
  }

  enum "core.entry_kind" as e_kind {
    PAYMENT_RECEIVED
    CONVERSION
    HOLD
    RELEASE
    PAYOUT
    REFUND
    REVERSAL
  }

  enum "core.ledger_account" as e_account {
    PAYER
    MERCHANT
    GATEWAY
    ESCROW
    CONVERSION_PROVIDER
    RECOVERY
  }

  note bottom of postings
    Em cada lançamento, as partidas
    somam zero por ativo
    (conferido no COMMIT).
  end note

  entity "ethereum.transactions" as eth_transactions <<imutável>> #EAF3EA {
    * id : uuid <<PK>>
    --
    * entry_id : uuid <<FK>>
    * kind : ethereum.transaction_kind
    * tx_hash : bytea
    * log_index : int
    * occurred_at : timestamptz
    .. UK (tx_hash, log_index) ..
  }

  entity "pix.transfers" as pix_transfers <<imutável>> #EAF3EA {
    * id : uuid <<PK>>
    --
    * entry_id : uuid <<FK>>
    * kind : pix.transfer_kind
    * end_to_end_id : text <<UK>>
    * occurred_at : timestamptz
  }

  enum "pix.transfer_kind" as e_pix_transfer {
    RECEIVED
    SENT
    REFUNDED
  }

  enum "ethereum.transaction_kind" as e_eth_tx {
    PAID
    HELD
    RELEASED
    FORWARDED
    REFUNDED
    RECOVERED
  }
}

package "Tipos comuns" as g_types {
  enum "core.rail" as e_rail {
    PIX
    ETHEREUM
  }

  enum "core.asset" as e_asset {
    BRL
    ETH
  }
}

' Chaves estrangeiras
identity_stores ||-down-o{ merchants
merchants ||-down-o{ payments
payments |o-left-o{ jobs
payments ||-right-o{ pix_meds
payments ||-down-o| eth_holds
payments ||-down-o| eth_payouts
payments ||-down-o| eth_charges
payments ||-down-o| pix_payouts
payments ||-down-o| pix_charges
payments ||-down-o{ entries
entries ||-left-|{ postings
entries ||-down-o| eth_transactions
entries ||-down-o| pix_transfers
pix_meds ||-down-|{ pix_med_events

' Posicionamento (sem significado no modelo)
identity_stores -[hidden]right- e_isstatus
jobs -[hidden]right- idem
idem -[hidden]down- chain_cursor
jobs -[hidden]down- e_jtype
e_jtype -[hidden]right- e_jstatus
pix_charges -[hidden]down- e_pstatus
postings -[hidden]down- e_account
entries -[hidden]down- e_kind
pix_transfers -[hidden]down- e_pix_transfer
eth_transactions -[hidden]down- e_eth_tx
pix_med_events -[hidden]down- e_med
e_rail -[hidden]right- e_asset
eth_holds -[hidden]down- pix_meds

@enduml
