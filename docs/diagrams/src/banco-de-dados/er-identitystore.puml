@startuml er-identitystore
!pragma layout elk
!include ../_estilo.iuml

title Banco do IdentityStore

hide circle
hide empty members
skinparam linetype ortho
skinparam noteTextAlignment left

package "Titulares" as g_owner {
  entity "core.owners" as owners {
    * id : uuid <<PK>>
    --
    * legal_name : bytea
    * document : bytea
    * created_at : timestamptz
  }

  note as n_owner
    Toda coluna bytea é cifrada
    pela aplicação.
  end note
}

package "Destinos" as g_dest {
  entity "pix.keys" as pix_keys {
    * id : uuid <<PK>>
    --
    * owner_id : uuid <<FK>>
    * type : pix.key_type
    * value : bytea
    * created_at : timestamptz
  }

  enum "pix.key_type" as pix_key_type {
    CPF
    CNPJ
    EMAIL
    PHONE
    EVP
  }

  entity "ethereum.wallets" as eth_wallets {
    * id : uuid <<PK>>
    --
    * owner_id : uuid <<FK>>
    * chain_id : bigint
    * address : bytea
    * siwe_message : bytea
    * siwe_signature : bytea
    * created_at : timestamptz
  }
}

package "Processamento" as g_proc {
  entity "core.idempotency_keys" as idem {
    * scope_id : text <<PK>>
    * key : text <<PK>>
    --
    * request_hash : text
    * resource_id : uuid
    * expires_at : timestamptz
  }
}

' Chaves estrangeiras
owners ||-down-o{ pix_keys
owners ||-down-o{ eth_wallets

' Posicionamento (sem significado no modelo)
pix_keys -[hidden]down- pix_key_type
@enduml
