@startuml seq-criar-pagamento-pix-eth
!include ../_estilo.iuml
hide footbox
autonumber

title Criar pagamento — Pix → Ethereum

actor "Sistema do lojista" as SL
participant "API REST" as API
participant "Orquestrador de\npagamentos" as ORQ
participant "payout :\nEthereumPayout" as PO
participant "payment :\nPayment" as PAY
participant ":IdentityStore" as IDS
participant ":ConversionProvider" as CONV
participant "PixRail :\nPaymentRail" as RAIL
participant ":PaymentRepository" as REPO

SL -> API : POST /v1/payments\n{amount, PIX → ETHEREUM, walletId}\n+ Idempotency-Key
API -> ORQ : createPayment(merchant, amount,\nPIX, ETHEREUM, walletId, idempotencyKey)
ORQ -> IDS : walletBelongsTo(walletId, merchant.ownerId)
IDS --> ORQ : true
opt amount em ETH
  ORQ -> CONV : quote(ETH, BRL, amount)
  CONV --> ORQ : quote (valor em BRL)
end
note right of ORQ
  chargeAmount é o valor que o
  pagador paga, no ativo do trilho
  de origem: o próprio amount
  ou o valor cotado.
end note
ORQ -> RAIL : createCharge(paymentId, chargeAmount, expiresAt)
RAIL --> ORQ : charge : PixCharge
create PO
ORQ -> PO : «create»(walletId)
create PAY
ORQ -> PAY : «create»(paymentId, merchant, amount,\nexpiresAt, charge, payout)
ORQ -> REPO : insert(payment, idempotencyKey)
ORQ --> API : payment
API --> SL : 201 {paymentId, checkoutUrl,\namountToPay, pixCopiaECola}
@enduml
