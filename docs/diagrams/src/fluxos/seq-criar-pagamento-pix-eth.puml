@startuml seq-criar-pagamento-pix-eth
!include ../_estilo.iuml
hide footbox
autonumber

title Criar pagamento — Pix → Ethereum

actor "Sistema do lojista" as SL
participant "API REST" as API
participant "Orquestrador de\npagamentos" as ORQ
participant "payout :\nEthereumPayout" as PO
participant "payment :\nPayment" as PAY
participant ":IdentityStore" as IDS
participant ":ConversionProvider" as CONV
participant "PixRail :\nPaymentRail" as RAIL
participant ":PaymentRepository" as REPO

SL -> API : POST /v1/payments\n{price, PIX → ETHEREUM, walletId}\n+ Idempotency-Key
API -> ORQ : createPayment(merchant, price,\nPIX, ETHEREUM, walletId, idempotencyKey)
ORQ -> IDS : walletBelongsTo(walletId, merchant.ownerId)
IDS --> ORQ : true
opt price em ETH
  ORQ -> CONV : quote(ETH, BRL, price)
  CONV --> ORQ : quote (valor em BRL)
end
ORQ -> RAIL : createCharge(paymentId, amount, expiresAt)
RAIL --> ORQ : charge : PixCharge
create PO
ORQ -> PO : «create»(walletId)
create PAY
ORQ -> PAY : «create»(paymentId, merchant, price,\nexpiresAt, charge, payout)
ORQ -> REPO : insert(payment, idempotencyKey)
ORQ --> API : payment
API --> SL : 201 {paymentId, checkoutUrl, brCode}
@enduml
