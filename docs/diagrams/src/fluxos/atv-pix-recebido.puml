@startuml atv-pix-recebido
!include ../_estilo.iuml

title Processamento de um Pix recebido (Pix → Ethereum)

start
:webhook do PSP recebido;
if (o pagamento do txid já tem\ntarefa CONFIRM_PAYMENT?) then (sim)
  :responder 200 e ignorar;
  stop
else (não)
endif
:GET /cob/{txid} no PSP\n(o Pix pago e seu endToEndId);
if (pagamento em AWAITING_PAYMENT?) then (não)
  :registrar e ignorar\n(fora de ordem ou repetido);
  stop
else (sim)
endif
:lançamento + pix.transfers (RECEIVED);
if (valor pago = valor da cobrança\ne provedor aceitou o pedido?) then (não)
  :devolução Pix total\nlançamento + pix.transfers (RETURNED);
  stop
else (sim)
endif
:paga a cobrança do provedor\nlançamento + pix.transfers (CONVERSION_FUNDED);
:provedor entrega o ETH com hold()\nlançamento + core.conversions\nlançamento + ethereum.transactions (HELD);
:agenda a tarefa RELEASE\npara release_at;
stop
@enduml
