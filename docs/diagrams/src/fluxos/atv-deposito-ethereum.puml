@startuml atv-deposito-ethereum
!include ../_estilo.iuml

title Processamento de um pagamento em ETH (Ethereum → Pix)

start
:evento Paid lido da blockchain;
if (já existe tarefa com dedup_key eth:{txHash}:{logIndex}?) then (sim)
  :ignorar;
  stop
else (não)
endif
:aguardar N confirmações;
if (pagamento em AWAITING_PAYMENT?) then (não)
  if (pagamento EXPIRED?) then (sim)
    :lançamento + ethereum.transactions (PAID);
    :refund() ao pagador\nlançamento + ethereum.transactions (REFUNDED);
    :status EXPIRED → REFUNDED;
    stop
  else (não)
    :registrar para o operador;
    stop
  endif
else (sim)
endif
:status → PROCESSING\nlançamento + ethereum.transactions (PAID);
if (valor = cotação e antes de expires_at?) then (não)
  :refund() ao pagador\nlançamento + ethereum.transactions (REFUNDED);
  :status → REFUNDED;
  stop
else (sim)
endif
:forward() ao provedor\nlançamento + ethereum.transactions (FORWARDED);
:provedor entrega o BRL\nlançamento + core.conversions;
:buscar chave Pix no IdentityStore;
:envio de Pix ao lojista;
if (Pix liquidado?) then (sim)
  :status → COMPLETED\nlançamento + pix.transfers (SENT);
else (não)
  :status → FAILED (operador);
endif
stop
@enduml
