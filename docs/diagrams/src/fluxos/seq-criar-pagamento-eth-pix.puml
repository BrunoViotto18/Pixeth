@startuml seq-criar-pagamento-eth-pix
!include ../_estilo.iuml
hide footbox
autonumber

title Criar pagamento — Ethereum → Pix

actor "Sistema do lojista" as SL
participant "API REST" as API
participant "Orquestrador de\npagamentos" as ORQ
participant "payout :\nPixPayout" as PO
participant "payment :\nPayment" as PAY
participant ":IdentityStore" as IDS
participant ":ConversionProvider" as CONV
participant "EthereumRail :\nPaymentRail" as RAIL
participant ":PaymentRepository" as REPO

SL -> API : POST /v1/payments\n{amount, ETHEREUM → PIX, keyId}\n+ Idempotency-Key
API -> ORQ : createPayment(merchant, amount,\nETHEREUM, PIX, keyId, idempotencyKey)
ORQ -> IDS : pixKeyBelongsTo(keyId, merchant.ownerId)
IDS --> ORQ : true
opt amount em BRL
  ORQ -> CONV : quote(BRL, ETH, amount)
  CONV --> ORQ : quote (valor em ETH)
end
note right of ORQ
  chargeAmount é o valor que o
  pagador paga, no ativo do trilho
  de origem: o próprio amount
  ou o valor cotado.
end note
ORQ -> RAIL : createCharge(paymentId, chargeAmount, expiresAt)
RAIL --> ORQ : charge : EthereumCharge
create PO
ORQ -> PO : «create»(keyId)
create PAY
ORQ -> PAY : «create»(paymentId, merchant, amount,\nexpiresAt, charge, payout)
ORQ -> REPO : insert(payment, idempotencyKey)
ORQ --> API : payment
API --> SL : 201 {paymentId, checkoutUrl,\namountToPay, ethereum}
@enduml
