@startuml uc-pagador
!include ../_estilo.iuml

title Casos de uso — Pagador

left to right direction

actor "Pagador" as P

rectangle "Pixeth" {
  usecase "Abrir checkout" as UC_Checkout
  usecase "Pagar com Pix" as UC_PagarPix
  usecase "Pagar com ETH (MetaMask)" as UC_PagarEth
  usecase "Receber devolução" as UC_Reembolso
}

P -- UC_Checkout
P -- UC_PagarPix
P -- UC_PagarEth
P -- UC_Reembolso

note right of UC_Reembolso
  Quando o pagamento não pode ser
  concluído (valor errado, pago após o
  vencimento, cotação vencida, falha
  na conversão) ou um MED é aceito,
  o valor volta pelo mesmo meio.
end note
@enduml
