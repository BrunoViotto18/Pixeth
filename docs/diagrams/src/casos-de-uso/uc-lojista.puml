@startuml uc-lojista
!include ../_estilo.iuml

title Casos de uso — Lojista e sistema do lojista

left to right direction

actor "Lojista" as L
actor "Sistema do lojista" as SL

rectangle "Pixeth" {
  usecase "Gerar credencial de API" as UC_Credencial
  usecase "Autenticar-se (com MFA)" as UC_Login
  usecase "Cadastrar-se" as UC_Cadastro
  usecase "Remover destino de recebimento" as UC_Remover
  usecase "Inscrever carteira" as UC_Carteira
  usecase "Provar posse da carteira (SIWE)" as UC_Siwe
  usecase "Inscrever chave Pix" as UC_ChavePix
  usecase "Criar pagamento" as UC_Criar
  usecase "Consultar pagamentos" as UC_Consultar
}

L -- UC_Credencial
L -- UC_Login
L -- UC_Cadastro
L -- UC_Remover
L -- UC_Carteira
L -- UC_ChavePix
L -- UC_Criar
L -- UC_Consultar
SL -- UC_Criar
SL -- UC_Consultar

UC_Carteira ..> UC_Siwe : <<include>>
@enduml
