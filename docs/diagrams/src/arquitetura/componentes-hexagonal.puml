@startuml componentes-hexagonal
!include ../_estilo.iuml

title Arquitetura hexagonal do processador

left to right direction
skinparam component<<porta>> {
  BackgroundColor #FFF8E8
  BorderColor #B08A3C
}

package "Adaptadores de entrada" as g_in {
  component "API REST\n(lojista e checkout)" as restApi
  component "Webhooks do PSP" as pspWebhook
  component "Ouvinte da blockchain" as chainListener
  component "Executor de tarefas" as jobRunner
  component "Console do operador" as console
}

package "Núcleo" as g_core {
  component "Cadastro" <<porta>> as IMerch
  component "Pagamentos" <<porta>> as IPay
  component "Operação" <<porta>> as IOps
  component "Avisos de pagamento" <<porta>> as INotif
  component "Execução de tarefas" <<porta>> as ISteps

  component "Lojistas e destinos" as merchants
  component "Operação\n(MED, falhas, IdentityStores)" as ops
  component "Orquestrador de pagamentos" as orch
  component "Livro-razão" as ledger
  component "AC da implantação" as pki

  component "IdentityStore" <<porta>> as IIdentity
  component "Repositórios" <<porta>> as IRepo
  component "JobQueue" <<porta>> as IJobs
  component "PaymentRail" <<porta>> as IRail
  component "ConversionProvider" <<porta>> as IConv
}

package "Adaptadores de saída" as g_out {
  component "Cliente IdentityStore\n(mTLS)" as idClient
  component "PostgreSQL" as pg
  component "Trilho Ethereum\n(Web3j + PixethGateway)" as ethRail
  component "Trilho Pix\n(API Pix — Efí)" as pixRail
  component "Conversão simulada" as convMock
  component "Tabela de tarefas" as jobTable
}

restApi --> IMerch
restApi --> IPay
pspWebhook --> INotif
chainListener --> INotif
jobRunner --> ISteps
console --> IOps

IMerch --> merchants
IPay --> orch
IOps --> ops
INotif --> orch
ISteps --> orch

ops --> pki
orch --> ledger

merchants ...> IIdentity
merchants ...> IRepo
ledger ..> IRepo
ops ...> IJobs
orch ...> IJobs
orch ...> IRail
orch ...> IConv

IIdentity <|.. idClient
IRepo <|.. pg
IRail <|.. pixRail
IRail <|.. ethRail
IConv <|.. convMock
IJobs <|.. jobTable
@enduml
